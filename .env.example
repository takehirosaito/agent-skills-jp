# agent-skills.jp 環境変数サンプル
# 実利用時は .env にコピーして値を埋めること。.env は git に含めない。

# GitHub Personal Access Token (Search API + repo metadata)
# 5,000 req/h 制限。https://github.com/settings/tokens で取得
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API Key (text-embedding-3-small 用)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API Key (Claude Haiku 翻訳用)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Meilisearch
MEILI_URL=http://localhost:7700
# 強い秘密鍵を生成: openssl rand -hex 32
MEILI_MASTER_KEY=replace-me-with-openssl-rand-hex-32

# (オプション) パイプラインのデータ出力先を上書き
# AGENT_SKILLS_DATA_DIR=/abs/path/to/data
# AGENT_SKILLS_CLONE_DIR=/abs/path/to/clones
